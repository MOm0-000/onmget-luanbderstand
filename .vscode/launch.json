        {
            "name": "eth_in (Windows component test)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}\\build\\eth_in.exe",
            "args": [
                "testing\\data\\eth_in"
            ],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "miDebuggerPath": "${config:cmake.debugConfig.miDebuggerPath}",
            "preLaunchTask": "build component tests",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ]
